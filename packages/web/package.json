{
  "name": "@simpludify/web",
  "version": "0.1.6",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@simpludify/core": "0.1.6",
    "pixi.js": "8.22.0"
  },
  "description": "Browser host, PixiJS rendering and input for the experimental Simpludify 2D engine.",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts",
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oz-coden/Simpludify.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.oz-coden.com/Simpludify/",
  "bugs": {
    "url": "https://github.com/oz-coden/Simpludify/issues"
  },
  "keywords": [
    "2d",
    "game-engine",
    "pixijs",
    "typescript",
    "experimental"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
