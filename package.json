{
  "name": "simpludify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/cli.mjs dev",
    "create": "node scripts/cli.mjs create",
    "check": "node scripts/cli.mjs check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "node scripts/cli.mjs build",
    "doctor": "node scripts/cli.mjs doctor",
    "bench": "node scripts/benchmark.mjs",
    "licenses": "node scripts/licenses.mjs",
    "format": "biome check --write .",
    "bench:browser": "node scripts/benchmark-browser.mjs",
    "test:build": "npm run build -- --target web --base /Simpludify/ && node scripts/smoke-build.mjs",
    "test:build:game": "npm run build -- --target web --example signal-run --base /Simpludify/ && node scripts/smoke-build.mjs --example signal-run",
    "bench:practical": "node --expose-gc scripts/benchmark-practical.mjs",
    "bench:response": "node --expose-gc scripts/benchmark-response.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:check": "node scripts/site-check.mjs",
    "site:serve": "node scripts/site-serve.mjs",
    "test:site": "node scripts/site-smoke.mjs",
    "bench:shooter": "node --expose-gc scripts/benchmark-shooter.mjs",
    "replay:demo": "node scripts/replay-demo.mjs",
    "bench:replay-memory": "node --expose-gc scripts/benchmark-replay-memory.mjs",
    "bench:movement": "node --expose-gc scripts/benchmark-movement.mjs",
    "bench:renderable": "node scripts/benchmark-renderable.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "markdown-it": "15.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
